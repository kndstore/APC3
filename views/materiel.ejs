<!-- 🌗 Mode clair/sombre script -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const body = document.body;
      const toggleBtn = document.createElement("button");
      toggleBtn.id = "toggleMode";
      toggleBtn.textContent = localStorage.getItem("theme") === "light" ? "🌙" : "☀️";

      if (localStorage.getItem("theme") === "light") body.classList.add("light-mode");
      document.body.prepend(toggleBtn);

      toggleBtn.addEventListener("click", () => {
        body.classList.toggle("light-mode");
        const isLight = body.classList.contains("light-mode");
        localStorage.setItem("theme", isLight ? "light" : "dark");
        toggleBtn.textContent = isLight ? "🌙" : "☀️";
      });
    });
  </script>

<!-- ✏️ ÉDITION -->
<script>
document.querySelectorAll('.editBtn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const row = e.target.closest('tr');
    const id = row.dataset.id;

    const data = {
      designation: row.children[0].textContent.trim(),
      qte: Number(row.children[1].textContent.trim()),
      ns: row.children[2].textContent.trim(),
      position: row.children[3].textContent.trim(),
      section: row.children[4].textContent.trim(),
      date_entree: row.children[5].textContent.trim()
    };

    try {
      const res = await fetch(`/materiel/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) alert('✅ Matériel mis à jour !');
      else alert('❌ Erreur lors de la mise à jour');
    } catch (err) {
      alert('⚠️ Erreur réseau');
    }
  });
});
</script>

<!-- 🗑 SUPPRESSION -->
<script>
document.querySelectorAll('.deleteBtn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const row = e.target.closest('tr');
    const id = row.dataset.id;

    if (!confirm('Voulez-vous vraiment supprimer ce matériel ?')) return;

    try {
      const res = await fetch(`/materiel/${id}`, { method: 'DELETE' });
      if (res.ok) {
        row.remove();
        alert('🗑 Matériel supprimé !');
      } else {
        alert('❌ Erreur lors de la suppression');
      }
    } catch (err) {
      alert('⚠️ Erreur réseau');
    }
  });
});
</script>

<!-- ➕ AJOUT -->
<script>
const addForm = document.getElementById('addForm');
addForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(addForm);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/materiel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      alert('✅ Matériel ajouté et stock mis à jour !');
      location.reload(); // Recharge la page pour voir le nouveau matériel
    } else {
      // Lire le message du serveur
      const message = await res.text();
      alert(`⚠️ ${message}`);
    }
  } catch (err) {
    console.error(err);
    alert('⚠️ Erreur réseau');
  }
});
</script>


<!-- 🔎 FILTRAGE -->
<script>
const filterDesignation = document.getElementById('filterDesignation');
const filterSection = document.getElementById('filterSection');
const filterPosition = document.getElementById('filterPosition');
const table = document.getElementById('materielTable');

// ✅ Créer un élément pour afficher la somme (s’il n’existe pas déjà)
let totalContainer = document.getElementById('totalQte');
if (!totalContainer) {
  totalContainer = document.createElement('div');
  totalContainer.id = 'totalQte';
  totalContainer.className = 'mt-3 fw-bold text-end text-success';
  table.parentElement.appendChild(totalContainer);
}

if (table) {
  function normalize(s) {
    return (s || '').toString().trim().toLowerCase();
  }

  function filterTable() {
    const designationValue = normalize(filterDesignation.value);
    const sectionValue = normalize(filterSection.value);
    const positionValue = normalize(filterPosition.value);

    let totalQte = 0; // ✅ somme des quantités visibles

    Array.from(table.getElementsByTagName('tr')).forEach(row => {
      const designation = normalize(row.children[0].textContent);
      const qte = parseFloat(row.children[1].textContent) || 0;
      const position = normalize(row.children[3].textContent);
      const section = normalize(row.children[4].textContent);

      const matchDesignation = designation.includes(designationValue);
      const matchSection = sectionValue === "" || section === sectionValue;
      const matchPosition = positionValue === "" || position === positionValue;

      const visible = (matchDesignation && matchSection && matchPosition);
      row.style.display = visible ? "" : "none";

      if (visible) totalQte += qte; // ✅ ajouter la quantité si visible
    });

    // ✅ Afficher la somme totale
    totalContainer.textContent = `Total des quantités affichées : ${totalQte}`;
  }

  // ✅ Écouteurs de filtres
  filterDesignation.addEventListener('input', filterTable);
  filterSection.addEventListener('change', filterTable);
  filterPosition.addEventListener('change', filterTable);

  // Appel initial
  filterTable();
}
</script>

<!-- 🔎 EXPORTER PDF -->

<script>
  document.getElementById('exportPDF').addEventListener('click', () => {
    const { jsPDF } = window.jspdf;

    const doc = new jsPDF({
      orientation: 'landscape',
      unit: 'mm',
      format: 'a4'
    });

    // 🔹 Titre
    doc.setFont("helvetica", "bold");
    doc.setFontSize(16);
    doc.text("Liste du Matériel - APC Zighoud Youcef", 148, 15, { align: "center" });

    // 🔹 Récupération des données visibles
    const rows = [];
    const headers = [];
    const table = document.querySelector('.table tbody');
    const headerCells = document.querySelectorAll('.table thead th');

    headerCells.forEach((th, i) => {
      if (i < headerCells.length - 1) headers.push(th.textContent.trim());
    });

    table.querySelectorAll('tr').forEach(tr => {
      if (tr.style.display !== 'none') {
        const rowData = [];
        tr.querySelectorAll('td').forEach((td, i) => {
          if (i < tr.children.length - 1) rowData.push(td.textContent.trim());
        });
        rows.push(rowData);
      }
    });

    // 📊 Tableau centré
    doc.autoTable({
      head: [headers],
      body: rows,
      startY: 25,
      theme: 'grid',
      tableWidth: 'wrap',
      tableLineColor: [200, 200, 200],
      tableLineWidth: 0.1,
      styles: {
        fontSize: 9,
        cellPadding: 3,
        overflow: 'linebreak',
        halign: 'center'
      },
      headStyles: {
        fillColor: [46, 125, 50],
        textColor: 255,
        fontStyle: 'bold'
      },
      bodyStyles: {
        textColor: 20,
        lineColor: [200, 200, 200],
      },
      alternateRowStyles: {
        fillColor: [245, 245, 245]
      },
      margin: { top: 25 },
      // 🔹 Centrer horizontalement
      horizontalPageBreak: false,
      tableWidth: 'auto',
      didDrawPage: (data) => {
        const pageWidth = doc.internal.pageSize.getWidth();
        const tableWidth = data.table.width;
        const marginX = (pageWidth - tableWidth) / 2;
        data.settings.margin.left = marginX;
      },
      didDrawCell: (data) => {
        // rien ici
      },
      columnStyles: {
        0: { cellWidth: 60 },
        1: { cellWidth: 15 },
        2: { cellWidth: 40 },
        3: { cellWidth: 35 },
        4: { cellWidth: 40 },
        5: { cellWidth: 35 }
      },
      didDrawPage: (data) => {
        const date = new Date().toLocaleDateString();
        doc.setFontSize(10);
        doc.text(`Généré le ${date}`, 14, doc.internal.pageSize.height - 10);
        doc.text(
          `Page ${doc.internal.getNumberOfPages()}`,
          doc.internal.pageSize.width - 30,
          doc.internal.pageSize.height - 10
        );
      }
    });

    const date = new Date().toLocaleDateString().replace(/\//g, '-');
    doc.save(`Materiel_${date}.pdf`);
  });
</script>


<!-- 🔎EXPORTER FICHE D'INVENTAIRE   -->
<script>
document.getElementById('exportFiche').addEventListener('click', () => {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({
    orientation: 'portrait',
    unit: 'mm',
    format: 'a4'
  });

  // Récupérer la section sélectionnée
  const sectionSelect = document.getElementById('filterSection');
  const selectedSection = sectionSelect.value.trim();

  // Regrouper les matériels par section
  const rowsBySection = {};
  document.querySelectorAll('#materielTable tr').forEach(tr => {
    if (tr.style.display === 'none') return;
    const section = tr.children[4].textContent.trim() || "Non spécifiée";
    if (!rowsBySection[section]) rowsBySection[section] = [];
    rowsBySection[section].push([
      tr.children[0].textContent.trim(),
      tr.children[1].textContent.trim(),
      tr.children[2].textContent.trim(),
      tr.children[3].textContent.trim(),
      tr.children[5].textContent.trim()
    ]);
  });

  // Si une section est sélectionnée, ne garder qu’elle
  const sectionsToPrint = selectedSection
    ? { [selectedSection]: rowsBySection[selectedSection] || [] }
    : rowsBySection;

  let page = 1;
  Object.keys(sectionsToPrint).forEach((section, index) => {
    if (index > 0) doc.addPage();

    // 🔹 En-tête APC
    doc.setFont("helvetica", "bold");
    doc.setFontSize(14);
    doc.text("APC Zighoud Youcef", 105, 15, { align: "center" });

    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);
    doc.text("FICHE D’INVENTAIRE DU MATÉRIEL", 105, 25, { align: "center" });
    doc.line(20, 27, 190, 27);

    doc.setFontSize(11);
    doc.text(`Section : ${section}`, 20, 40);
    const date = new Date().toLocaleDateString();
    doc.text(`Date : ${date}`, 160, 40, { align: "right" });

    const headers = ["Désignation", "Qté", "N° Série", "État", "Date Entrée"];
    const rows = sectionsToPrint[section] || [];

    // 🧾 Tableau
    doc.autoTable({
      startY: 45,
      head: [headers],
      body: rows.length ? rows : [["(Aucun matériel trouvé)", "", "", "", ""]],
      theme: 'grid',
      styles: { fontSize: 9, halign: 'center' },
      headStyles: { fillColor: [22, 163, 74], textColor: 255, fontStyle: 'bold' },
      alternateRowStyles: { fillColor: [245, 245, 245] },
      margin: { left: 10, right: 10 }
    });

    // 🔹 Pied de page : signature
    const finalY = doc.lastAutoTable.finalY + 20;
    doc.text("Signature du responsable :", 20, finalY);
    doc.line(70, finalY, 140, finalY);
    doc.text("Cachet :", 20, finalY + 20);
    doc.line(45, finalY + 20, 100, finalY + 20);

    doc.setFontSize(10);
    doc.text(`Page ${page}`, 180, 285);
    page++;
  });

  const fileName = selectedSection
    ? `Fiche_Inventaire_${selectedSection}.pdf`
    : `Fiches_Inventaire_Toutes_Sections.pdf`;
  doc.save(fileName);
});
</script>
<script>
  // Récupérer l'élément input
  const dateInput = document.getElementById('date_entree');

  // Créer la date du jour au format YYYY-MM-DD
  const today = new Date();
  const yyyy = today.getFullYear();
  const mm = String(today.getMonth() + 1).padStart(2, '0'); // Mois commence à 0
  const dd = String(today.getDate()).padStart(2, '0');

  // Mettre la valeur de l'input date
  dateInput.value = `${yyyy}-${mm}-${dd}`;
</script>
