<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion du Matériel - APC Zighoud Youcef</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <!-- 🔹 jsPDF + AutoTable -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
 <style>
    :root {
      --red: #e11d48;
      --green: #16a34a;
      --white: #ffffff;
      --dark-bg: #0f172a;
      --light-bg: #f8fafc;
      --dark-text: #e2e8f0;
      --light-text: #111827;
    }

    body {
      font-family: 'Roboto', sans-serif;
      background: radial-gradient(circle at top left, #052e16, #0f172a);
      color: var(--dark-text);
      transition: all 0.4s ease;
      padding-top: 80px;
    }

    body.light-mode {
      background: radial-gradient(circle at top left, #e6f4ea, #ffffff);
      color: var(--light-text);
    }

    /* 🔹 NAVBAR */
    .navbar {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(10px);
      border-bottom: 2px solid var(--green);
      transition: 0.4s;
    }

    body.light-mode .navbar {
      background: rgba(255, 255, 255, 0.85);
      border-bottom: 2px solid var(--red);
    }

    .navbar-brand img {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      animation: spin 8s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .navbar-brand span {
      color: var(--green);
      font-weight: 700;
    }
    body.light-mode .navbar-brand span {
      color: var(--red);
    }

    /* 🔗 Liens de la navbar */
    .btnnav-link {
      padding: 6px 15px;
      border-radius: 8px;
      background-color: rgba(255, 255, 255, 0.1);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .btnnav-link:hover {
      background: var(--green);
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 3px 10px rgba(22, 163, 74, 0.4);
    }

    body.light-mode .btnnav-link {
      color: var(--light-text);
      background-color: rgba(255, 255, 255, 0.6);
    }
    body.light-mode .btnnav-link:hover {
      background: var(--red);
      color: #fff;
    }

    /* 🌈 Boutons */
    .btn-success {
      background: var(--green);
      border: none;
      transition: 0.3s;
    }
    .btn-success:hover {
      background: #15803d;
      transform: scale(1.05);
    }

    .btn-danger {
      background: var(--red);
      border: none;
      transition: 0.3s;
    }
    .btn-danger:hover {
      background: #be123c;
      transform: scale(1.05);
    }

    .btn-warning {
      background: #fff;
      color: var(--green);
      font-weight: bold;
      border: 2px solid var(--green);
      transition: 0.3s;
    }
    .btn-warning:hover {
      background: var(--green);
      color: #fff;
    }

    body.light-mode .btn-warning {
      color: var(--red);
      border-color: var(--red);
    }
    body.light-mode .btn-warning:hover {
      background: var(--red);
      color: #fff;
    }

    /* 🧾 Table */
    .table thead {
      background: var(--green);
      color: #fff;
    }

    body.light-mode .table thead {
      background: var(--red);
    }

    .table tbody tr:hover {
      background: rgba(34, 197, 94, 0.1);
    }
    body.light-mode .table tbody tr:hover {
      background: rgba(225, 29, 72, 0.1);
    }

    /* 💎 Carte */
    .glass-card {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 16px;
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      transition: 0.3s;
      padding: 15px;
      width: 98%;
    }

    body.light-mode .glass-card {
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(0, 0, 0, 0.1);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }

    /* 🌙 Bouton mode */
    #toggleMode {
      background: var(--green);
      color: white;
      border: none;
      border-radius: 8px;
      transition: 0.3s;
    }
    #toggleMode:hover {
      background: var(--red);
    }
    body.light-mode #toggleMode {
      background: var(--red);
    }
    body.light-mode #toggleMode:hover {
      background: var(--green);
    }

    /* Déconnexion */
    .logout {
      background: var(--red);
      color: white;
      border-radius: 8px;
      padding: 6px 12px;
      transition: 0.3s;
      border: none;
    }
    .logout:hover {
      background: #b91c1c;
      transform: scale(1.05);
    }

    /* Entrées et filtres */
    input, select {
      border-radius: 8px;
      border: 1px solid #ccc;
      transition: all 0.3s ease;
    }
    input:focus, select:focus {
      border-color: var(--green);
      box-shadow: 0 0 6px rgba(22, 163, 74, 0.4);
    }
    body.light-mode input:focus, body.light-mode select:focus {
      border-color: var(--red);
      box-shadow: 0 0 6px rgba(225, 29, 72, 0.4);
    }

    footer {
      text-align: center;
      margin-top: 2rem;
      color: #94a3b8;
    }
    body.light-mode footer {
      color: #475569;
    }
  </style>
</head>

<body>

<!-- 🔹 NAVBAR FIXE -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="#">
      <img src="/images/ZY.png" alt="Logo APC" width="40" height="40" class="me-2 rounded-circle shadow-sm">
      <span class="fw-bold">APC Zighoud Youcef</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-between" id="mainNav">
      <ul class="navbar-nav align-items-center gap-2">
        <li><a class="btnnav-link" href="/materiel?nom=<%= nom %>&role=<%= role %>">🏠 Accueil</a></li>
        <li><a class="btnnav-link" href="/section?nom=<%= nom %>&role=<%= role %>">📁 Sections</a></li>
        <% if (role === 'Administrateur') { %>
          <li><a class="btnnav-link" href="/stock?nom=<%= nom %>&role=<%= role %>">📦 Stock</a></li>
          <li><a class="btnnav-link" href="/utilisateurs?nom=<%= nom %>&role=<%= role %>">👥 Utilisateurs</a></li>
        <% } %>
      </ul>

      <ul class="navbar-nav align-items-center gap-2">
        <li><p class="text-light mb-0">👋 <%= nom %> (<%= role %>)</p></li>
        
        <li><a href="/" class="btn btn-sm btn-outline-light">← Déconnexion</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- 🔹 CONTENU -->
<div class="container">
  <div class="glass-card">
    <h4 class="text-center mb-4 text-success">📦 Liste du Matériel</h4>
<!-- 🔹 Bouton qui défile vers le formulaire d’ajout -->

    <!-- 🔎 Filtres -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
      <!-- Désignation -->
      <div class="input-group w-auto">
        <span class="input-group-text bg-success text-white">🔍</span>
        <input 
          type="text" 
          id="filterDesignation" 
          class="form-control" 
          placeholder="Rechercher par désignation..."
          list="designationsList"
          autocomplete="off">
        <datalist id="designationsList">
          <% 
            const uniqueDesignations = [...new Set(materiels.map(m => (m.designation || '').toString().trim()))].filter(Boolean);
            uniqueDesignations.forEach(des => { 
          %>
            <option value="<%= des %>"></option>
          <% }) %>
        </datalist>
      </div>


  <button id="exportPDF" class="btn btn-danger">📄 Exporter en PDF</button>


  <button class="btn btn-warning">
  <a href="#addForm" class="text-decoration-none text-dark fw-bold">➕ Ajouter</a>
  </button>
      <!-- Section -->
      <div class="input-group w-auto">
        <span class="input-group-text bg-primary text-white">🏢</span>
        <select id="filterSection" class="form-select">
          <option value="">Toutes les sections</option>
          <% 
            const uniqueSections = [...new Set(materiels.map(m => (m.section || '').toString().trim()))].filter(Boolean);
            uniqueSections.forEach(section => { 
          %>
            <option value="<%= section %>"><%= section %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- 🧾 TABLE -->
    <div class="table-responsive">
      <table class="table table-hover align-middle text-center">
        <thead>
          <tr>
            <th>Désignation</th>
            <th>Qté</th>
            <th>N° Série</th>
            <th>Position</th>
            <th>Section</th>
            <th>Date d'entrée</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="materielTable">
          <% materiels.forEach(m => { %>
            <tr data-id="<%= m._id %>">
              <td contenteditable="true"><%= m.designation %></td>
              <td contenteditable="true"><%= m.qte %></td>
              <td contenteditable="true"><%= m.ns %></td>
              <td contenteditable="true"><%= m.position %></td>
              <td contenteditable="true"><%= m.section %></td>
              <td contenteditable="true"><%= m.date_entree.toISOString().split('T')[0] %></td>
              <td>
                <button class="btn btn-warning btn-sm editBtn">💾</button>
                <button class="btn btn-danger btn-sm deleteBtn">🗑</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <hr class="border-light my-4">
    <h5 class="text-success " >➕ Ajouter un matériel</h5>

   
    <form id="addForm" class="row g-3">
      <div class="col-md-4">
       <input class="form-control" list="designationList" name="designation" placeholder="Désignation" required>
       <datalist id="designationList"></datalist>
      </div>
        <script>
  // 🔹 Charger les désignations depuis MongoDB
  fetch('/stock/designations')
    .then(res => res.json())
    .then(data => {
      const list = document.getElementById('designationList');
      list.innerHTML = ''; // vider avant
      data.forEach(designation => {
        const option = document.createElement('option');
        option.value = designation;
        list.appendChild(option);
      });
    })
    .catch(err => console.error('Erreur chargement désignations:', err));
        </script>
      <div class="col-md-2">
        <input class="form-control" type="number" name="qte" placeholder="Qté" required>
      </div>
      <div class="col-md-3">
        <input class="form-control" name="ns" placeholder="Numéro de série" required>
      </div>
      <div class="col-md-3">
        <input class="form-control" name="position" placeholder="Position" required>
      </div>
      <div class="col-md-4">
  <input class="form-control" list="sectionList" name="section" placeholder="Section" required>
  <datalist id="sectionList"></datalist>
</div>

<script>
  // 🔹 Charger les sections depuis MongoDB
  fetch('/section/noms')
    .then(res => res.json())
    .then(data => {
      const list = document.getElementById('sectionList');
      list.innerHTML = '';
      data.forEach(section => {
        const option = document.createElement('option');
        option.value = section;
        list.appendChild(option);
      });
    })
    .catch(err => console.error('Erreur chargement sections:', err));
</script>

      <div class="col-md-4">
        <input class="form-control" type="date" name="date_entree" required>
      </div>
      <div class="col-md-4 d-grid">
        <button class="btn btn-success">Ajouter</button>
      </div>
    </form>
  </div>
</div>

<p class="text-center mt-4 opacity-75">© 2025 — APC Zighoud Youcef | Gestion du Matériel</p>

<!-- 🌗 Mode clair/sombre script -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const body = document.body;
      const toggleBtn = document.createElement("button");
      toggleBtn.id = "toggleMode";
      toggleBtn.textContent = localStorage.getItem("theme") === "light" ? "🌙" : "☀️";

      if (localStorage.getItem("theme") === "light") body.classList.add("light-mode");
      document.body.prepend(toggleBtn);

      toggleBtn.addEventListener("click", () => {
        body.classList.toggle("light-mode");
        const isLight = body.classList.contains("light-mode");
        localStorage.setItem("theme", isLight ? "light" : "dark");
        toggleBtn.textContent = isLight ? "🌙" : "☀️";
      });
    });
  </script>

<!-- ✏️ ÉDITION -->
<script>
document.querySelectorAll('.editBtn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const row = e.target.closest('tr');
    const id = row.dataset.id;

    const data = {
      designation: row.children[0].textContent.trim(),
      qte: Number(row.children[1].textContent.trim()),
      ns: row.children[2].textContent.trim(),
      position: row.children[3].textContent.trim(),
      section: row.children[4].textContent.trim(),
      date_entree: row.children[5].textContent.trim()
    };

    try {
      const res = await fetch(`/materiel/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) alert('✅ Matériel mis à jour !');
      else alert('❌ Erreur lors de la mise à jour');
    } catch (err) {
      alert('⚠️ Erreur réseau');
    }
  });
});
</script>

<!-- 🗑 SUPPRESSION -->
<script>
document.querySelectorAll('.deleteBtn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const row = e.target.closest('tr');
    const id = row.dataset.id;

    if (!confirm('Voulez-vous vraiment supprimer ce matériel ?')) return;

    try {
      const res = await fetch(`/materiel/${id}`, { method: 'DELETE' });
      if (res.ok) {
        row.remove();
        alert('🗑 Matériel supprimé !');
      } else {
        alert('❌ Erreur lors de la suppression');
      }
    } catch (err) {
      alert('⚠️ Erreur réseau');
    }
  });
});
</script>

<!-- ➕ AJOUT -->
<script>
const addForm = document.getElementById('addForm');
addForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(addForm);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/materiel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      alert('✅ Matériel ajouté et stock mis à jour !');
      location.reload(); // Recharge la page pour voir le nouveau matériel
    } else {
      // Lire le message du serveur
      const message = await res.text();
      alert(`⚠️ ${message}`);
    }
  } catch (err) {
    console.error(err);
    alert('⚠️ Erreur réseau');
  }
});
</script>


<!-- 🔎 FILTRAGE -->
<script>
const filterDesignation = document.getElementById('filterDesignation');
const filterSection = document.getElementById('filterSection');
const table = document.getElementById('materielTable');

if (table) {
  function normalize(s) {
    return (s || '').toString().trim().toLowerCase();
  }

  function filterTable() {
    const designationValue = normalize(filterDesignation.value);
    const sectionValue = normalize(filterSection.value);

    Array.from(table.getElementsByTagName('tr')).forEach(row => {
      const designation = normalize(row.children[0].textContent);
      const section = normalize(row.children[4].textContent);

      const matchDesignation = designation.includes(designationValue);
      const matchSection = sectionValue === "" || section === sectionValue;

      row.style.display = (matchDesignation && matchSection) ? "" : "none";
    });
  }

  filterDesignation.addEventListener('input', filterTable);
  filterSection.addEventListener('change', filterTable);
}
</script>
<!-- 🔎 EXPORTER PDF -->

<script>
  document.getElementById('exportPDF').addEventListener('click', () => {
    const { jsPDF } = window.jspdf;

    const doc = new jsPDF({
      orientation: 'landscape',
      unit: 'mm',
      format: 'a4'
    });

    // 🔹 Titre
    doc.setFont("helvetica", "bold");
    doc.setFontSize(16);
    doc.text("Liste du Matériel - APC Zighoud Youcef", 148, 15, { align: "center" });

    // 🔹 Récupération des données visibles
    const rows = [];
    const headers = [];
    const table = document.querySelector('.table tbody');
    const headerCells = document.querySelectorAll('.table thead th');

    headerCells.forEach((th, i) => {
      if (i < headerCells.length - 1) headers.push(th.textContent.trim());
    });

    table.querySelectorAll('tr').forEach(tr => {
      if (tr.style.display !== 'none') {
        const rowData = [];
        tr.querySelectorAll('td').forEach((td, i) => {
          if (i < tr.children.length - 1) rowData.push(td.textContent.trim());
        });
        rows.push(rowData);
      }
    });

    // 📊 Tableau centré
    doc.autoTable({
      head: [headers],
      body: rows,
      startY: 25,
      theme: 'grid',
      tableWidth: 'wrap',
      tableLineColor: [200, 200, 200],
      tableLineWidth: 0.1,
      styles: {
        fontSize: 9,
        cellPadding: 3,
        overflow: 'linebreak',
        halign: 'center'
      },
      headStyles: {
        fillColor: [46, 125, 50],
        textColor: 255,
        fontStyle: 'bold'
      },
      bodyStyles: {
        textColor: 20,
        lineColor: [200, 200, 200],
      },
      alternateRowStyles: {
        fillColor: [245, 245, 245]
      },
      margin: { top: 25 },
      // 🔹 Centrer horizontalement
      horizontalPageBreak: false,
      tableWidth: 'auto',
      didDrawPage: (data) => {
        const pageWidth = doc.internal.pageSize.getWidth();
        const tableWidth = data.table.width;
        const marginX = (pageWidth - tableWidth) / 2;
        data.settings.margin.left = marginX;
      },
      didDrawCell: (data) => {
        // rien ici
      },
      columnStyles: {
        0: { cellWidth: 60 },
        1: { cellWidth: 15 },
        2: { cellWidth: 40 },
        3: { cellWidth: 35 },
        4: { cellWidth: 40 },
        5: { cellWidth: 35 }
      },
      didDrawPage: (data) => {
        const date = new Date().toLocaleDateString();
        doc.setFontSize(10);
        doc.text(`Généré le ${date}`, 14, doc.internal.pageSize.height - 10);
        doc.text(
          `Page ${doc.internal.getNumberOfPages()}`,
          doc.internal.pageSize.width - 30,
          doc.internal.pageSize.height - 10
        );
      }
    });

    const date = new Date().toLocaleDateString().replace(/\//g, '-');
    doc.save(`Materiel_${date}.pdf`);
  });
</script>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
