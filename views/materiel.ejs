<script>
  
  document.querySelectorAll('#myTable th').forEach((th, index) => {
    th.style.cursor = 'pointer'; // Indicateur visuel
    th.addEventListener('click', () => {
      const table = th.closest('table');
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));

      // Détecte si la colonne est numérique ou textuelle par le premier ligne
      const isNumeric = !isNaN(rows[0].cells[index].textContent.trim());

      // Trie ascendant/descendant alterné
      let asc = th.asc !== true;
      th.asc = asc;

      rows.sort((a, b) => {
        const cellA = a.cells[index].textContent.trim();
        const cellB = b.cells[index].textContent.trim();

        if (isNumeric) {
          return asc ? cellA - cellB : cellB - cellA;
        } else {
          return asc ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
        }
      });

      // Remplace les lignes
      rows.forEach(row => tbody.appendChild(row));
    });
  });
</script>
