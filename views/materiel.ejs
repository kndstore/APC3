<style>

  /* Font moderne */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap');




/* 🌟 Conteneur flex */
.d-flex {
  gap: 2rem; /* espace entre les cartes */
  flex-wrap: wrap;
  justify-content: center; /* centre les cartes si espace libre */
}

/* 🌟 Cartes statistiques */
.stat-card {
  display: flex;flex-direction: column;
  align-items: center;
  align-content: center;
  justify-content: space-between;
  
  background: linear-gradient(135deg, #6a11cb, #2575fc); /* dégradé moderne */
  color: #fff;
  padding: 3px;
  border-radius: 1rem;
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  width: 180px;
  text-align: center;
  transition: transform 0.3s, box-shadow 0.3s;
  cursor: pointer;
}

/* 🌟 Animation hover */
.stat-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 25px rgba(0,0,0,0.3);
}

/* 🌟 Icones */
.stat-icon {
  font-size: 1rem;
  margin-bottom: 1rem;
}

/* 🌟 Titres */
.stat-title {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

/* 🌟 Valeurs */
.stat-value {
  font-size: 2rem;
  font-weight: 700;
}

/* 🌟 Responsive pour mobile */
@media (max-width: 768px) {
  .stat-card {
    width: 100%;
  }
}

  * {
      font-family: "Nunito", sans-serif;
      font-optical-sizing: auto;
      font-style: normal;
    }
a {
  color: inherit;        /* Hérite de la couleur du parent */
  text-decoration: none; /* Enlève le soulignement */
}
:root {
  --green: #16a34a;
  --green-dark: #0f3d22;
  --red: #e11d48;
  --blue: #1e3a8a;
  --light-bg: #f8fafc;
  --dark-bg: #0f172a;
  --light-text: #111827;
  --dark-text: #f1f1f1;
  --card-bg: rgba(255,255,255,0.05);
  --card-bg-light: rgba(255,255,255,0.95);
}

/* 🌙 Général */
body {
  width: 100%;
  overflow: visible;
  font-family: 'Roboto', sans-serif;
  background: linear-gradient(135deg, #052e16, #0f172a);
  color: var(--dark-text);
  padding-top: 80px; 
  height: 100vh;
  transition: all 0.3s ease;
}
body.light-mode {
  background: linear-gradient(135deg, #e6f4ea, #ffffff);
  color: var(--light-text);
}

/* 🔹 Navbar */
.navbar {
  background: rgba(27,27,27,0.95) !important;
  backdrop-filter: blur(10px);
  border-bottom: 2px solid var(--green);
}
.navbar .navbar-brand, 
.navbar .nav-link, 
.navbar .navbar-text p .sss{
  color: var(--dark-text) !important;
}
body.light-mode .navbar {
  background: rgba(255,255,255,0.95) !important;
  border-bottom: 2px solid var(--red);
}
body.light-mode .navbar .navbar-brand,
body.light-mode .navbar .nav-link,
body.light-mode .navbar .navbar-text p .sss{
  color: var(--light-text) !important;
}

/* 🔹 Boutons principaux */
.btn-success, .btn-danger, .btn-warning {
  border-radius: 12px;
  font-weight: 600;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  transition: all 0.3s ease;
}
.btn-success:hover { transform: scale(1.05); box-shadow: 0 6px 12px rgba(0,0,0,0.2); }
.btn-danger:hover { transform: scale(1.05); box-shadow: 0 6px 12px rgba(0,0,0,0.2); }
.btn-warning:hover { transform: scale(1.05); box-shadow: 0 6px 12px rgba(0,0,0,0.2); }

/* 🔹 Bouton mode clair/sombre */
#toggleMode {
  border-radius: 50%;
  padding: 8px 14px;
  font-size: 1rem;
  position: fixed;
  top: 90px;
  right: 20px;
  z-index: 999;
  cursor: pointer;
  transition: 0.3s;
}
#toggleMode:hover { transform: scale(1.1); }

/* 🔹 Carte glassmorphism */
.glass-card {
  background: var(--card-bg);
  border-radius: 16px;
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow: 0 8px 32px rgba(0,0,0,0.25);
  padding: 20px;
  margin-bottom: 20px;
}
body.light-mode .glass-card {
  background: var(--card-bg-light);
  border: 1px solid rgba(0,0,0,0.1);
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

/* 🔹 Inputs et selects */
input, select {
  border-radius: 12px;
  border: 1px solid #ccc;
  padding: 8px 12px;
  transition: all 0.3s ease;
}
input:focus, select:focus {
  border-color: var(--green);
  box-shadow: 0 0 8px rgba(22,163,74,0.3);
}
body.light-mode input:focus, body.light-mode select:focus {
  border-color: var(--red);
  box-shadow: 0 0 8px rgba(225,29,72,0.3);
}

/* 🔹 Table moderne */
.table thead {
  background: var(--green);
  color: #fff;
}
body.light-mode .table thead { background: var(--red); }
.table tbody tr:hover {
  background: rgba(34,197,94,0.1);
  transition: 0.2s;
}
body.light-mode .table tbody tr:hover { background: rgba(225,29,72,0.1); }

/* 🔹 Boutons navbar */
.btnnav-link {
  display: inline-block;
  padding: 8px 18px;
  border-radius: 10px;
  background-color: #2f855a;
  color: #fff;
  font-weight: 600;
  transition: all 0.25s ease;
}
.btnnav-link:hover {
  transform: translateY(-2px);
}
body.light-mode .btnnav-link {
  color: var(--light-text);
  background-color: rgba(255, 255, 255, 0.6);
}
body.light-mode .btnnav-link:hover {
  background:  #2f855a;
  color: #fff;
}

/* 🔹 Footer */
footer {
  text-align: center;
  margin-top: 2rem;
  color: #94a3b8;
}
body.light-mode footer { color: #475569; }

/* 🖥️ PC normal (≥1100px) */
@media (min-width: 1100px) {
    body {
        zoom: 1;
    }
}

/* 📱 Mobiles + Tablettes (≤1100px) */
@media (max-width: 1100px) {
    body {
        zoom: 1.25; /* augmente la taille */
    }
}

/* 📱 Très petits téléphones (≤480px) */
@media (max-width: 480px) {
    body {
        zoom: 1.35; /* encore plus large pour lecture */
    }
}


</style>

</head>

