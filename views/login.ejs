<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"> <!-- ✅ essentiel pour mobile -->
  <title>Connexion</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: url('/images/ALGERIA.jpg') no-repeat center center fixed;
      background-size: cover;
      min-height: 100vh;
      display: flex;
      align-items: center; /* ✅ centré verticalement */
      justify-content: center; /* ✅ centré horizontalement */
      font-family: 'Poppins', sans-serif;
      animation: fadeIn 1s ease-in-out;
      margin: 0;
      padding: 1rem; /* ✅ pour éviter que la carte touche les bords sur mobile */
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-card {
      background: rgba(255, 255, 255, 0.85); /* ✅ carte blanche semi-transparente */
      color: #0f172a;
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      width: 100%;
      max-width: 380px; /* ✅ taille adaptée aux téléphones */
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      backdrop-filter: blur(6px); /* ✅ effet de verre dépoli */
    }

    .login-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.3);
    }

    .login-card h2 {
      margin-bottom: 1.5rem;
      font-weight: 700;
      color: #22c55e; /* vert vif */
    }

    .form-control {
      border-radius: 10px;
      border: 1px solid #c3e6cb;
      padding: 0.75rem;
      font-size: 0.95rem;
    }

    .btn-primary {
      background-color: #22c55e;
      border: none;
      border-radius: 12px;
      transition: all 0.3s ease;
      font-weight: 600;
      font-size: 1rem;
    }

    .btn-primary:hover {
      background-color: #16a34a;
      transform: scale(1.03);
    }

    .alert {
      background-color: #f8d7da;
      color: #842029;
      border-radius: 10px;
      padding: 0.75rem 1rem;
      margin-bottom: 1rem;
      font-size: 0.9rem;
    }

    footer {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.8rem;
      color: #0f172a;
    }
  </style>
</head>

<body>
  <div class="login-card shadow">
    <h2>🔐 Connexion</h2>

    <% if (message) { %>
      <div class="alert text-center"><%= message %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3 text-start">
        <label class="form-label">Nom d'utilisateur</label>
        <input type="text" name="username" class="form-control" placeholder="Entrez votre nom" required>
      </div>

      <div class="mb-3 text-start">
        <label class="form-label">Mot de passe</label>
        <input type="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button class="btn btn-primary w-100 py-2">Se connecter</button>
    </form>
  </div>

  <footer>
    © 2025 - Gestion du Matériel | Design Moderne
  </footer>
</body>
</html>
