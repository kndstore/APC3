<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1"> <!-- ✅ essentiel pour mobile -->
  <title>Connexion</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: url('/images/ALGERIA.jpg') no-repeat center center fixed;
      background-size: cover;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Poppins', sans-serif;
      animation: fadeIn 1s ease-in-out;
      margin: 0;
      padding: 1rem;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-card {
      background: rgba(255, 255, 255, 0.88);
      color: #0f172a;
      padding: 2.5rem 2rem;
      border-radius: 20px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
      width: 100%;
      max-width: 420px; /* ✅ plus large pour mobile */
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      backdrop-filter: blur(8px);
    }

    @media (max-width: 768px) {
      .login-card {
        padding: 3rem 2rem;
        max-width: 95%; /* ✅ occupe presque tout l’écran sur téléphone */
      }
    }

    .login-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.3);
    }

    .login-card h2 {
      margin-bottom: 2rem;
      font-weight: 700;
      color: #22c55e;
      font-size: 1.8rem;
    }

    .form-label {
      font-weight: 600;
      color: #1e293b;
    }

    .form-control {
      border-radius: 12px;
      border: 1px solid #c3e6cb;
      padding: 0.9rem;
      font-size: 1rem;
    }

    .btn-primary {
      background-color: #22c55e;
      border: none;
      border-radius: 14px;
      transition: all 0.3s ease;
      font-weight: 600;
      font-size: 1.1rem;
    }

    .btn-primary:hover {
      background-color: #16a34a;
      transform: scale(1.04);
    }

    .alert {
      background-color: #f8d7da;
      color: #842029;
      border-radius: 12px;
      padding: 0.85rem 1.2rem;
      margin-bottom: 1.2rem;
      font-size: 0.95rem;
    }

    footer {
      margin-top: 1.8rem;
      text-align: center;
      font-size: 0.85rem;
      color: #f1f5f9;
      text-shadow: 0 1px 3px rgba(0,0,0,0.4);
    }
  </style>
</head>

<body>
  <div class="login-card shadow">
    <h2>🔐 Connexion</h2>

    <% if (message) { %>
      <div class="alert text-center"><%= message %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3 text-start">
        <label class="form-label">Nom d'utilisateur</label>
        <input type="text" name="username" class="form-control" placeholder="Entrez votre nom" required>
      </div>

      <div class="mb-4 text-start">
        <label class="form-label">Mot de passe</label>
        <input type="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button class="btn btn-primary w-100 py-2">Se connecter</button>
    </form>
  </div>

  <footer>
    © 2025 - Gestion du Matériel | A.P.C Zighoud Youcef
  </footer>
</body>
</html>
