<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Connexion</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #d4edda; /* vert clair doux */
      min-height: 100vh;
      display: flex;
      align-items:end;
      justify-content: center;
      font-family: 'Poppins', sans-serif;
      animation: fadeIn 1s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-card {
      background: #fff;
      color: #0f172a;
      padding: 2.5rem 2rem;
      border-radius: 16px;
      box-shadow: 10px 8px 20px rgba(0,0,0,0.15);
      width: 100%;
      max-width: 400px;
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      
    }

    .login-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.2);
    }

    .login-card h2 {
      margin-bottom: 1.5rem;
      font-weight: 700;
      color: #22c55e; /* vert plus vif */
    }

    .form-control {
      border-radius: 10px;
      border: 1px solid #c3e6cb;
      padding: 0.75rem;
    }

    .btn-primary {
      background-color: #22c55e; /* vert vif */
      border: none;
      border-radius: 12px;
      transition: all 0.3s ease;
      font-weight: 600;
    }

    .btn-primary:hover {
      background-color: #16a34a; /* vert foncé */
      transform: scale(1.05);
    }

    .alert {
      background-color: #f8d7da; /* rouge clair pour erreur */
      color: #842029;
      border-radius: 10px;
      padding: 0.75rem 1rem;
      margin-bottom: 1rem;
    }

    footer {
      margin-top: 2rem;
      text-align: center;
      font-size: 0.85rem;
      color: #0f172a;
    }
  </style>
</head>

<body style="flex-direction: column; 
             background: url('/images/ALGERIA.jpg') no-repeat center center fixed;
             background-size: cover;">
<div class="login-card shadow" style="background-color: rgba(214, 22, 22, 0.384);">
    <h2>🔐 Connexion</h2>

    <% if (message) { %>
      <div class="alert text-center"><%= message %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label>Nom d'utilisateur</label>
        <input type="text" name="username" class="form-control" placeholder="Entrez votre nom" required>
      </div>

      <div class="mb-3">
        <label>Mot de passe</label>
        <input type="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button class="btn btn-primary w-100 py-2">Se connecter</button>
    </form>
  </div>

  <footer>
    © 2025 - Gestion du Matériel | Design Moderne
  </footer>
</body>
</html>
