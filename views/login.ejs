<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Connexion</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap');

    body {
      background: linear-gradient(135deg, #d4e8db, #a7c4bc);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Inter', sans-serif;
      margin: 0;
      padding: 1rem;
         background: url('/images/ALGERIA.jpg') no-repeat center center;

    }

    .login-card {
      background-color: #ffffffcc;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgb(0 0 0 / 0.1);
      padding: 3rem 2.5rem;
      max-width: 400px;
      width: 100%;
      text-align: center;
      transition: box-shadow 0.4s ease, transform 0.3s ease;
    }
    .login-card:hover {
      box-shadow: 0 20px 40px rgb(0 0 0 / 0.15);
      transform: translateY(-5px);
    }

    h2 {
      font-weight: 600;
      color: #2c7a7b;
      margin-bottom: 2rem;
      font-size: 2rem;
    }

    .form-label {
      font-weight: 600;
      color: #334e68;
      display: block;
      margin-bottom: 8px;
    }

    .form-control {
      border: 1.5px solid #b9c8c8;
      border-radius: 10px;
      padding: 0.85rem 1rem;
      font-size: 1rem;
      transition: border-color 0.3s ease;
    }
    .form-control:focus {
      border-color: #38a169;
      outline: none;
      box-shadow: 0 0 5px #38a169aa;
    }

    .btn-primary {
      background-color: #38a169;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      padding: 0.75rem;
      font-size: 1.1rem;
      transition: background-color 0.3s ease, transform 0.2s ease;
    }
    .btn-primary:hover {
      background-color: #2f855a;
      transform: scale(1.05);
    }

    .alert {
      background-color: #fed7d7;
      color: #9b2c2c;
      border-radius: 10px;
      padding: 0.75rem 1rem;
      margin-bottom: 1.2rem;
      font-size: 0.95rem;
      font-weight: 600;
    }

    footer {
      margin-top: 2rem;
      text-align: center;
      color: #2f855a;
      font-weight: 600;
      font-size: 0.9rem;
    }

    @media (max-width: 576px) {
      .login-card {
        padding: 2.5rem 1.5rem;
        max-width: 90%;
      }
    }
  </style>
</head>

<body>
  <div class="login-card shadow">
    <h2>🔐 Connexion</h2>

    <% if (message) { %>
      <div class="alert text-center"><%= message %></div>
    <% } %>

    <form action="/login" method="POST">
      <label class="form-label" for="username">Nom d'utilisateur</label>
      <input id="username" type="text" name="username" class="form-control mb-3" placeholder="Entrez votre nom" required />

      <label class="form-label" for="password">Mot de passe</label>
      <input id="password" type="password" name="password" class="form-control mb-4" placeholder="••••••••" required />

      <button class="btn btn-primary w-100" type="submit">Se connecter</button>
    </form>
  </div>

  <footer>
    © 2025 - Gestion du Matériel | A.P.C Zighoud Youcef
  </footer>
</body>
</html>