<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion du Stock</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --bg-dark: #0f172a;
      --bg-light: #f8fafc;
      --text-dark: #e2e8f0;
      --text-light: #0f172a;
      --accent: #3b82f6;
      --accent-light: #60a5fa;
      --danger: #ef4444;
      --success: #22c55e;
      --warning: #facc15;
    }

    body {
      background: radial-gradient(circle at top left, #1e3a8a, #0f172a);
      color: var(--text-dark);
      min-height: 100vh;
      font-family: 'Poppins', sans-serif;
      transition: all 0.5s ease;
    }

    body.light-mode {
      background: radial-gradient(circle at top left, #dbeafe, #f8fafc);
      color: var(--text-light);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 16px;
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
    }

    body.light-mode .glass-card {
      background: rgba(255, 255, 255, 0.8);
      color: #0f172a;
      border: 1px solid rgba(0, 0, 0, 0.1);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    .glass-card:hover {
      transform: translateY(-5px);
    }

    th {
      background-color: rgba(255, 255, 255, 0.1);
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
    }

    body.light-mode th {
      background-color: rgba(0, 0, 0, 0.05);
    }

    .btn {
      border-radius: 10px;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background: var(--accent);
      border: none;
    }

    .btn-primary:hover {
      background: var(--accent-light);
      transform: scale(1.05);
    }

    .btn-toggle {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: var(--text-dark);
    }

    body.light-mode .btn-toggle {
      border: 1px solid rgba(0, 0, 0, 0.4);
      color: var(--text-light);
    }
body.light-mode h4 {
  color: #1e3a8a !important; /* Bleu foncé ou couleur de ton choix */
}

    .btn-toggle:hover {
      background: var(--accent);
      color: white;
    }

    .form-control {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
    }

    body.light-mode .form-control {
      background: rgba(0, 0, 0, 0.05);
      color: #000;
    }

    .logout:hover {
      background-color: #ef4444;
      color: #fff;
      transform: scale(1.05);
    }
  </style>
</head>

<body class="container py-5">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h5>👋 Bienvenue <strong><%= nom %></strong> (<%= role %>)</h5>
    <div class="d-flex gap-2">
      <button id="toggleMode" class="btn btn-toggle">🌙 Mode Sombre</button>
      <a href="/materiel?nom=<%= nom %>&role=<%= role %>" class="btn btn-primary">📁 Acceuil</a>
      <a href="/" class="btn btn-outline-light logout " style="color: gold;background: #1e3a8a;">← Déconnexion</a>
    </div>
  </div>

  <!-- MAIN CARD -->
  <div class="glass-card p-4">
    <h4 class="mb-3 text-center text-light" style="color: forestgreen;">📦 Liste du Matériel</h4>

    <div class="table-responsive">
      <table class="table table-hover align-middle text-center">
        <thead>
          <tr>
            <th>Désignation</th>
            <th>Qté</th>
            <th>N° Série</th>
          
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% materiels.forEach(m => { %>
            <tr data-id="<%= m._id %>">
              <td contenteditable="true"><%= m.designation %></td>
              <td contenteditable="true"><%= m.qte %></td>
              <td contenteditable="true"><%= m.ns %></td>
             <td>
                <button class="btn btn-warning btn-sm editBtn">💾</button>
                <button class="btn btn-danger btn-sm deleteBtn">🗑</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <hr class="border-light my-4">

    <h5 class="mb-3">➕ Ajouter un matériel au stock</h5>

    <form id="addForm" class="row g-3">
      <div class="col-md-4">
        <input class="form-control" name="designation" placeholder="Désignation" required>
      </div>
      <div class="col-md-2">
        <input class="form-control" type="number" name="qte" placeholder="Qté" required>
      </div>
      <div class="col-md-3">
        <input class="form-control" name="ns" placeholder="Numéro de série" required>
      </div>
      
      
      
      <div class="col-md-4 d-grid">
        <button class="btn btn-success">Ajouter</button>
      </div>
    </form>
  </div>

  <p class="text-center mt-4 opacity-75">© 2025 — Gestion du stock  </p>

  <script>
    // 🌗 TOGGLE MODE SOMBRE / CLAIR
    const toggleBtn = document.getElementById('toggleMode');
    const body = document.body;

    // Charger le mode sauvegardé
    if (localStorage.getItem('theme') === 'light') {
      body.classList.add('light-mode');
      toggleBtn.textContent = '🌙 Mode Sombre';
    } else {
      body.classList.remove('light-mode');
      toggleBtn.textContent = '☀️ Mode Clair';
    }

    toggleBtn.addEventListener('click', () => {
      body.classList.toggle('light-mode');
      if (body.classList.contains('light-mode')) {
        localStorage.setItem('theme', 'light');
        toggleBtn.textContent = '🌙 Mode Sombre';
      } else {
        localStorage.setItem('theme', 'dark');
        toggleBtn.textContent = '☀️ Mode Clair';
      }
    });

    // ➕ AJOUT
    document.getElementById('addForm').addEventListener('submit', async e => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target).entries());
      const res = await fetch('/stock/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) location.reload();
    });

    // 💾 MODIF
    document.querySelectorAll('.editBtn').forEach(btn => {
      btn.addEventListener('click', async e => {
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const cells = tr.querySelectorAll('td');
        const data = {
          designation: cells[0].innerText,
          qte: cells[1].innerText,
          ns: cells[2].innerText,
         
        };
        const res = await fetch(`/stock/edit/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) showToast('stock ✅');
      });
    });

    // 🗑 SUPP
    document.querySelectorAll('.deleteBtn').forEach(btn => {
      btn.addEventListener('click', async e => {
        if (!confirm('Supprimer  ?')) return;
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const res = await fetch(`/stock/delete/${id}`, { method: 'DELETE' });
        if (res.ok) tr.remove();
      });
    });

    // ✅ TOAST
    function showToast(msg) {
      const toast = document.createElement('div');
      toast.className = "toast align-items-center text-bg-success border-0 show position-fixed bottom-0 end-0 m-4";
      toast.innerHTML = `
        <div class="d-flex">
          <div class="toast-body">${msg}</div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto"></button>
        </div>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
