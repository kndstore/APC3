<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion du Stock</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

  <style>
    body {
      background: linear-gradient(to bottom right, #f8fafc, #e2e8f0);
      font-family: 'Poppins', sans-serif;
      color: #1e293b;
      min-height: 100vh;
    }

    .navbar {
      background-color: #1e293b;
      border-radius: 12px;
      margin-bottom: 2rem;
    }

    .navbar .btn {
      border-radius: 8px;
      font-weight: 500;
    }

    .glass-card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.1);
      padding: 2rem;
      transition: all 0.3s ease;
    }

    .glass-card:hover {
      transform: translateY(-3px);
    }

    table {
      border-radius: 10px;
      overflow: hidden;
    }

    th {
      background-color: #f1f5f9;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
    }

    .btn {
      border-radius: 10px;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background-color: #3b82f6;
      border: none;
    }

    .btn-primary:hover {
      background-color: #2563eb;
    }

    .btn-warning {
      background-color: #facc15;
      border: none;
    }

    .btn-danger {
      background-color: #ef4444;
      border: none;
    }

    .btn-outline-dark {
      border-color: #1e293b;
      color: #1e293b;
    }

    .btn-outline-dark:hover {
      background-color: #1e293b;
      color: #fff;
    }

    .logout {
      background-color: #e2e8f0;
      color: #1e293b;
    }

    .logout:hover {
      background-color: #dc2626;
      color: white;
    }

    h4 {
      color: #1e3a8a;
      font-weight: 600;
    }

    footer {
      margin-top: 2rem;
      text-align: center;
      font-size: 0.85rem;
      color: #475569;
    }
  </style>
</head>

<body class="container py-4">

  <!-- HEADER -->
  <nav class="navbar navbar-dark px-4 d-flex justify-content-between align-items-center">
    <h5 class="text-light mb-0">📦 Gestion du Stock</h5>
    <div class="d-flex gap-2">
      <a href="/materiel?nom=<%= nom %>&role=<%= role %>" class="btn btn-primary btn-sm">Accueil</a>
      <a href="/" class="btn logout btn-sm">Déconnexion</a>
    </div>
  </nav>

  <!-- MAIN CARD -->
  <div class="glass-card">
    <h4 class="text-center mb-4">Liste du Matériel</h4>

    <div class="text-end mb-3">
      <button id="exportPDF" class="btn btn-outline-dark btn-sm">📄 Exporter en PDF</button>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered align-middle text-center">
        <thead class="table-light">
          <tr>
            <th>Désignation</th>
            <th>Quantité</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% materiels.forEach(m => { %>
            <tr data-id="<%= m._id %>">
              <td contenteditable="true"><%= m.designation %></td>
              <td contenteditable="true"><%= m.qte %></td>
              <td>
                <button class="btn btn-warning btn-sm editBtn">💾</button>
                <button class="btn btn-danger btn-sm deleteBtn">🗑</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <hr>

    <h5 class="mb-3">➕ Ajouter un matériel</h5>

    <form id="addForm" class="row g-3">
      <div class="col-md-6 col-lg-5">
        <input class="form-control" name="designation" placeholder="Désignation" required>
      </div>
      <div class="col-md-3 col-lg-2">
        <input class="form-control" type="number" name="qte" placeholder="Quantité" required>
      </div>
      <div class="col-md-3 col-lg-3 d-grid">
        <button class="btn btn-success">Ajouter</button>
      </div>
    </form>
  </div>

  <footer>
    © 2025 — Gestion du stock | Design moderne et épuré
  </footer>

  <!-- JS -->
  <script>
    // ➕ AJOUT
    document.getElementById('addForm').addEventListener('submit', async e => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target).entries());
      const res = await fetch('/stock/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) location.reload();
    });

    // 💾 MODIF
    document.querySelectorAll('.editBtn').forEach(btn => {
      btn.addEventListener('click', async e => {
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const cells = tr.querySelectorAll('td');
        const data = {
          designation: cells[0].innerText,
          qte: cells[1].innerText,
        };
        const res = await fetch(`/stock/edit/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) alert("✅ Stock modifié avec succès");
      });
    });

    // 🗑 SUPP
    document.querySelectorAll('.deleteBtn').forEach(btn => {
      btn.addEventListener('click', async e => {
        if (!confirm('Supprimer ce matériel ?')) return;
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const res = await fetch(`/stock/delete/${id}`, { method: 'DELETE' });
        if (res.ok) tr.remove();
      });
    });

    // 📄 EXPORT PDF
    document.getElementById("exportPDF").addEventListener("click", () => {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: "landscape", unit: "pt", format: "a4" });

      doc.setFontSize(18);
      doc.text("Liste du Stock - APC Zighoud Youcef", 40, 50);

      const today = new Date().toLocaleDateString();
      doc.setFontSize(10);
      doc.text(`Exporté le ${today}`, 40, 70);

      const rows = [];
      document.querySelectorAll("table tbody tr").forEach(tr => {
        const tds = tr.querySelectorAll("td");
        rows.push([tds[0].innerText.trim(), tds[1].innerText.trim()]);
      });

      doc.autoTable({
        startY: 90,
        head: [["Désignation", "Quantité"]],
        body: rows,
        theme: "grid",
        styles: { halign: "center", valign: "middle", fontSize: 11 },
        headStyles: { fillColor: [59, 130, 246], textColor: 255, fontStyle: "bold" },
      });

      doc.save("Stock_APC_Zighoud_Youcef.pdf");
    });
  </script>
</body>
</html>
