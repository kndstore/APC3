<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gestion des Utilisateurs</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body class="bg-light">

  <!-- 🔹 Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">Gestion Utilisateurs</a>

      <div class="d-flex align-items-center">
        <a href="/materiel?nom=<%= nom %>&role=<%= role %>" class="btn btn-outline-light btn-sm me-3">← Retour</a>
        <span class="navbar-text text-white">
          👋 <strong><%= nom %></strong> (<%= role %>)
        </span>
      </div>
    </div>
  </nav>

  <div class="container mt-4">

    <!-- ✅ Formulaire d’ajout -->
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-primary text-white">➕ Ajouter un utilisateur</div>
      <div class="card-body">
        <form id="addUserForm" autocomplete="off">
          <div class="row g-2">
            <div class="col-md-2">
              <input name="mle" class="form-control" placeholder="Matricule" required>
            </div>
            <div class="col-md-3">
              <input name="nom" class="form-control" placeholder="Nom complet" required>
            </div>
            <div class="col-md-3">
              <select name="role" class="form-select" required>
                <option value="">-- Choisir un rôle --</option>
                <option value="Administrateur">Administrateur</option>
                <option value="Utilisateur">Utilisateur</option>
              </select>
            </div>
            <div class="col-md-2">
              <input name="username" class="form-control" placeholder="Nom d’utilisateur" required>
            </div>
            <div class="col-md-2">
              <input name="password" type="password" class="form-control" placeholder="Mot de passe" required>
            </div>
          </div>
          <button class="btn btn-primary mt-3 w-100">✅ Ajouter</button>
        </form>
      </div>
    </div>

    <!-- ✅ Tableau des utilisateurs -->
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white">👥 Liste des utilisateurs</div>
      <div class="card-body p-0">
        <table class="table table-hover table-bordered align-middle text-center mb-0">
          <thead class="table-secondary">
            <tr>
              <th>Matricule</th>
              <th>Nom</th>
              <th>Rôle</th>
              <th>Nom d’utilisateur</th>
              <th>Mot de passe</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr data-id="<%= u._id %>">
                <td contenteditable="true"><%= u.mle %></td>
                <td contenteditable="true"><%= u.nom %></td>
                <td contenteditable="true"><%= u.role %></td>
                <td contenteditable="true"><%= u.username %></td>
                <td contenteditable="true"><%= u.password %></td>
                <td>
                  <button class="btn btn-sm btn-success btn-edit">💾</button>
                  <button class="btn btn-sm btn-danger btn-delete">🗑</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- ✅ Scripts CRUD -->
  <script>
    // ➕ Ajouter un utilisateur
    document.getElementById('addUserForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target));
      try {
        await axios.post('/utilisateurs/add', data);
        alert('Utilisateur ajouté ✅');
        location.reload();
      } catch (err) {
        alert('Erreur lors de l’ajout ❌');
      }
    });

    // 💾 Modifier un utilisateur
    document.querySelectorAll('.btn-edit').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const tds = tr.querySelectorAll('td');
        const updated = {
          mle: tds[0].innerText.trim(),
          nom: tds[1].innerText.trim(),
          role: tds[2].innerText.trim(),
          username: tds[3].innerText.trim(),
          password: tds[4].innerText.trim()
        };
        try {
          await axios.post(`/utilisateurs/edit/${id}`, updated);
          alert('Utilisateur modifié ✅');
        } catch (err) {
          alert('Erreur lors de la modification ❌');
        }
      });
    });

    // 🗑 Supprimer un utilisateur
    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (confirm('Supprimer cet utilisateur ?')) {
          const id = e.target.closest('tr').dataset.id;
          try {
            await axios.delete(`/utilisateurs/delete/${id}`);
            alert('Utilisateur supprimé ✅');
            location.reload();
          } catch (err) {
            alert('Erreur lors de la suppression ❌');
          }
        }
      });
    });
  </script>

</body>
</html>
